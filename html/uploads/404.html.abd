<!DOCTYPE html>
<html>
<head>
    <title>404 Not Found</title>
    <style>
        body {
            background-color: #1a1a1a;
            color: #e0e0e0;
            font-family: sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            text-align: center;
        }
        h1 {
            font-size: 3em;
            margin-bottom: 0.2em;
        }
        p {
            color: #a0a0a0;
        }
        img {
            margin-top: 1.5em;
            max-width: 300px;
        }
    </style>
</head>
<body>
    <h1>404 Not Found</h1>
    <p>The page you're looking for doesn't exist on this server.</p>
    <img src="/404.jpg" alt="404">
</body>
</html>
